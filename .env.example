# GEMINI_API_KEY: Server-side Gemini AI integration
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"

# ==========================================
# SUPABASE CLIENT CONFIGURATION
# ==========================================
# VITE_SUPABASE_URL: The REST API URL of your Supabase Project (Settings -> API)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# VITE_SUPABASE_ANON_KEY: Safe client-side anonymous public key (Settings -> API)
VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."


# ==========================================
# GOOGLE ADMOB CONFIGURATION
# ==========================================
# ADMOB_APP_ID: Your AdMob Android App ID (e.g. ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX)
ADMOB_APP_ID="ca-app-pub-3940256099942544~3347511713"

# ADMOB_REWARDED_UNIT_ID: Production rewarded ad unit ID
ADMOB_REWARDED_UNIT_ID="ca-app-pub-3940256099942544/5224354917"


# ==========================================
# 33MILADY SOLANA DEVNET
# ==========================================
# Public Devnet RPC used by server/indexer/transaction builders.
SOLANA_RPC_URL="https://api.devnet.solana.com"

# Server-side MarketLint attestor keypair. Never expose this to the browser.
MARKETLINT_ATTESTOR_KEYPAIR="~/.config/solana/marketlint-attestor.json"

# Protects operator-only certification calls and can authorize the E2E runner.
MARKETLINT_CERTIFY_TOKEN="replace-with-long-random-secret"

# Enable only for a controlled public Devnet demo. Public requests are rate-limited.
MARKETLINT_PUBLIC_CERTIFY="false"

# Certification lifetime, capped by the program at seven days.
MARKETLINT_CERT_TTL_SECS="86400"

# Optional manual indexer synchronization secret.
INDEXER_ADMIN_TOKEN="replace-with-long-random-secret"

# 33 Beta keeper/oracle configuration.
BETA_ORACLE_KEYPAIR="~/.config/solana/beta-oracle.json"
PYTH_API_KEY=""

# ==========================================
# MILESTONE 10 DEVNET E2E RUNNER
# ==========================================
MILADY_SERVER_URL="http://localhost:3000"
E2E_WALLET_KEYPAIR="~/.config/solana/id.json"
E2E_LIQUIDITY_USDG="25"
E2E_TRADE_USDG="1"
E2E_TRADE_SIDE="YES"
E2E_TRADE_DIRECTION="BUY"
E2E_MIN_OUT_BASE_UNITS="1"
E2E_CLOSE_SECS="300"
E2E_RESOLUTION_DELAY_SECS="0"
E2E_OUTCOME="YES"
