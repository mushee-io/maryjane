# Mary Jane — Solana Prediction Markets
# Copy only the values you need into Vercel Environment Variables.

# Solana Devnet RPC
SOLANA_RPC_URL="https://api.devnet.solana.com"

# MarketLint attestor for Vercel.
# Use the JSON secret-key array from the attestor keypair, e.g. [12,34,...].
# Never expose this as a VITE_ variable.
MARKETLINT_ATTESTOR_SECRET_KEY="[REPLACE_WITH_SECRET_KEY_ARRAY]"

# Local-PC fallback only. Do not use this path on Vercel.
# MARKETLINT_ATTESTOR_KEYPAIR="~/.config/solana/marketlint-attestor.json"

# Protect operator-only certification requests.
MARKETLINT_CERTIFY_TOKEN="REPLACE_WITH_LONG_RANDOM_SECRET"

# Controlled Devnet demo. Set true only when you want public market creation.
MARKETLINT_PUBLIC_CERTIFY="true"

# Certification lifetime in seconds.
MARKETLINT_CERT_TTL_SECS="86400"

# Optional admin protection for manual indexer synchronization.
INDEXER_ADMIN_TOKEN="REPLACE_WITH_LONG_RANDOM_SECRET"

# Optional Pyth keeper access.
PYTH_API_KEY=""

# Optional Beta keeper key for non-Vercel/local keeper jobs.
# BETA_ORACLE_KEYPAIR="~/.config/solana/beta-oracle.json"

# Local E2E runner only; not required by the Vercel deployment.
MARY_JANE_SERVER_URL="http://localhost:3000"
E2E_WALLET_KEYPAIR="~/.config/solana/id.json"
E2E_LIQUIDITY_USDG="25"
E2E_TRADE_USDG="1"
E2E_TRADE_SIDE="YES"
E2E_TRADE_DIRECTION="BUY"
E2E_MIN_OUT_BASE_UNITS="1"
E2E_CLOSE_SECS="300"
E2E_RESOLUTION_DELAY_SECS="0"
E2E_OUTCOME="YES"

# Cloudinary media uploads.
# The browser first tries the unsigned preset below. If your preset is signed-only,
# configure either CLOUDINARY_URL or the three server-only values so Mary Jane can
# request a short-lived signature from /api/cloudinary-signature.
VITE_CLOUDINARY_CLOUD_NAME="kbuxvbsa"
VITE_CLOUDINARY_UPLOAD_PRESET="ml_default"
CLOUDINARY_CLOUD_NAME="kbuxvbsa"
CLOUDINARY_UPLOAD_PRESET="ml_default"
# Preferred if supplied by the Cloudinary/Vercel integration:
# CLOUDINARY_URL="cloudinary://API_KEY:API_SECRET@kbuxvbsa"
# Or set these two server-only values instead:
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
