{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    },
    "api/marketlint-analyze.ts": {
      "maxDuration": 10
    },
    "api/prepare-create.ts": {
      "maxDuration": 60
    },
    "api/discovery-feed.ts": {
      "maxDuration": 60
    },
    "api/native-market-state.ts": {
      "maxDuration": 30
    },
    "api/order-place.ts": {
      "maxDuration": 30
    },
    "api/order-fill.ts": {
      "maxDuration": 30
    },
    "api/cloudinary-signature.ts": {
      "maxDuration": 10
    },
    "api/trader-state.ts": {
      "maxDuration": 60
    },
    "api/complete-set.ts": {
      "maxDuration": 30
    },
    "api/analytics-feed.ts": {
      "maxDuration": 30
    },
    "api/market-action.ts": {
      "maxDuration": 30
    },
    "api/forty-four-milady.ts": {
      "maxDuration": 60
    },
    "api/order-cancel.ts": {
      "maxDuration": 30
    },
    "api/order-cancel-direct.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/market-action",
      "dest": "/api/market-action"
    },
    {
      "src": "/api/analytics-feed",
      "dest": "/api/analytics-feed"
    },
    {
      "src": "/api/complete-set",
      "dest": "/api/complete-set"
    },
    {
      "src": "/api/trader-state",
      "dest": "/api/trader-state"
    },
    {
      "src": "/api/cloudinary-signature",
      "dest": "/api/cloudinary-signature"
    },
    {
      "src": "/api/native-market-state",
      "dest": "/api/native-market-state"
    },
    {
      "src": "/api/order-place",
      "dest": "/api/order-place"
    },
    {
      "src": "/api/order-fill",
      "dest": "/api/order-fill"
    },
    {
      "src": "/api/discovery-feed",
      "dest": "/api/discovery-feed"
    },
    {
      "src": "/api/prepare-create",
      "dest": "/api/prepare-create"
    },
    {
      "src": "/api/marketlint-analyze",
      "dest": "/api/marketlint-analyze"
    },
    {
      "src": "/api/order-cancel",
      "dest": "/api/order-cancel-direct"
    },
    {
      "src": "/api/v1/44-milady/(?<action>.*)",
      "dest": "/api/forty-four-milady?action=$action"
    },
    {
      "src": "/api/(?<path>.*)",
      "dest": "/api/index?path=$path"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "installCommand": "npm install --include=dev",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-DNS-Prefetch-Control",
          "value": "off"
        }
      ]
    }
  ]
}
