{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60
    },
    "api/marketlint-analyze.ts": {
      "maxDuration": 10
    },
    "api/prepare-create.ts": {
      "maxDuration": 60
    },
    "api/discovery-feed.ts": {
      "maxDuration": 60
    },
    "api/market-probe.ts": {
      "maxDuration": 15
    },
    "api/native-market-state.ts": {
      "maxDuration": 30
    },
    "api/order-place.ts": {
      "maxDuration": 30
    },
    "api/order-fill.ts": {
      "maxDuration": 30
    },
    "api/market-book.ts": {
      "maxDuration": 30
    },
    "api/order-cancel.ts": {
      "maxDuration": 30
    },
    "api/trader-state.ts": {
      "maxDuration": 30
    },
    "api/complete-set.ts": {
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/api/complete-set",
      "dest": "/api/complete-set"
    },
    {
      "src": "/api/trader-state",
      "dest": "/api/trader-state"
    },
    {
      "src": "/api/order-cancel",
      "dest": "/api/order-cancel"
    },
    {
      "src": "/api/native-market-state",
      "dest": "/api/native-market-state"
    },
    {
      "src": "/api/market-book",
      "dest": "/api/market-book"
    },
    {
      "src": "/api/order-place",
      "dest": "/api/order-place"
    },
    {
      "src": "/api/order-fill",
      "dest": "/api/order-fill"
    },
    {
      "src": "/api/market-probe",
      "dest": "/api/market-probe"
    },
    {
      "src": "/api/discovery-feed",
      "dest": "/api/discovery-feed"
    },
    {
      "src": "/api/prepare-create",
      "dest": "/api/prepare-create"
    },
    {
      "src": "/api/marketlint-analyze",
      "dest": "/api/marketlint-analyze"
    },
    {
      "src": "/api/(?<path>.*)",
      "dest": "/api/index?path=$path"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ],
  "installCommand": "npm install --include=dev"
}
