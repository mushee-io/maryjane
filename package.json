{
  "name": "mary-jane",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:indexer": "tsx src/lib/marketIndexer.spec.ts",
    "test:marketlint": "tsx src/lib/marketLint.spec.ts",
    "test:external-feed": "tsx scripts/external-feed-smoke.ts",
    "test:marketlint-function": "tsx scripts/marketlint-function-smoke.ts",
    "test:prepare-create-function": "tsx scripts/prepare-create-function-smoke.ts",
    "test:solana-runtime": "node scripts/solana-runtime-smoke.mjs",
    "postinstall": "node scripts/fix-pyth-node.mjs && node scripts/verify-solana-deps.mjs",
    "test:discovery-function": "tsx scripts/discovery-function-smoke.ts",
    "test:production-discovery": "node scripts/production-discovery-smoke.mjs",
    "demo:seed": "tsx scripts/seed-demo-markets.ts",
    "test:judge-readiness": "node scripts/judge-readiness.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "1.98.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.18.3",
    "rpc-websockets": "9.3.2",
    "uuid": "8.3.2",
    "bs58": "^6.0.0",
    "@pythnetwork/hermes-client": "3.1.0",
    "@pythnetwork/pyth-solana-receiver": "0.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "uuid": "8.3.2",
    "rpc-websockets": "9.3.2"
  },
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.x"
  },
  "resolutions": {
    "rpc-websockets": "9.3.2",
    "uuid": "8.3.2"
  },
  "pnpm": {
    "overrides": {
      "rpc-websockets": "9.3.2",
      "uuid": "8.3.2"
    }
  }
}
